    },
    "defaultHidden": true,
    "hiddenTarget": [
      "container",
      "stroke0",
      "stroke1"
    ],
    "hiddenReason": "真机父容器 SetVisible 不保证级联到子控件（v308 教训）⇒ 三层都默认隐藏，Lua 逐层开关",
    "visibilityFallback": "保留格内 x 的原有显隐逻辑作为兜底；X 为不透明纯色，同位叠加不产生可见差异"
  },
